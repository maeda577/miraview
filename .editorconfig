# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[src/{css,html,ts,ts/utils}/*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true

[src/{ts,ts/utils}/*]
# HTML,CSSは末尾に改行を入れてもVSCodeのフォーマットで消える
# tsだけ改行入れる
insert_final_newline = true
