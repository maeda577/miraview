// https://www.typescriptlang.org/ja/tsconfig/
{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "public/js",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "sourceMap": true,
    "declaration": true
  },
  "include": [
    "src/*.ts"
  ]
}
