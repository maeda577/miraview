{
  "name": "miraview",
  "version": "3.2.0",
  "description": "A web frontend for mirakc.",
  "keywords": [],
  "homepage": "https://github.com/maeda577/miraview",
  "bugs": {
    "url": "https://github.com/maeda577/miraview/issues"
  },
  "license": "MIT",
  "author": "maeda577",
  "type": "module",
  "devDependencies": {

    "@carbon/icon-helpers": "^10.54.0",
    "@carbon/icons": "^11.53.0",
    "@carbon/web-components": "^2.19.0",

    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@siemens/ix": "^2.6.1",
    "@siemens/ix-icons": "^2.2.0",
    "openapi-fetch": "^0.13.3",
    "openapi-typescript": "^7.4.4",
    "rollup": "^4.24.0",
    "sass": "^1.83.0",
    "serve": "^14.2.4",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "clean": "find public/js/ public/css/ -type f -name '*.js' -or -name '*.css' -delete",
    "setup-ix": "npx rollup --plugin @rollup/plugin-node-resolve --format esm --inlineDynamicImports --file public/ix/ix.js --input src/ix.js",
    "setup-ix-css": "cp node_modules/@siemens/ix/dist/siemens-ix/siemens-ix.css public/ix/",
    "setup-fetch": "mkdir -p public/openapi-fetch/ && cp node_modules/openapi-fetch/dist/index.js node_modules/openapi-fetch/LICENSE public/openapi-fetch/",
    "build": "npx sass --load-path=node_modules src/carbon.scss public/css/carbon.css && npx rollup --config rollup.config.mjs",
    "serve": "npx serve --no-clipboard ./"
  }
}
