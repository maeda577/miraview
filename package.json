{
  "dependencies": {
    "bootstrap": "^5",
    "bootstrap-icons": "^1",
    "igniteui-webcomponents": "^7",
    "openapi-fetch": "*"
  },
  "devDependencies": {
    "typescript": "^7",
    "rolldown": "^1"
  },
  "scripts": {
    "postinstall": "npm run copy-themes && npm run copy-skills && npm run download-icon",
    "copy-themes": "cp -r node_modules/igniteui-webcomponents/themes dist/",
    "copy-skills": "mkdir -p .agents/skills && cp -r node_modules/igniteui-webcomponents/skills/igniteui* .agents/skills/",
    "download-icon": "curl --location --output 'dist/resources/MaterialSymbolsOutlined[FILL,GRAD,opsz,wght].woff2' 'https://raw.githubusercontent.com/google/material-design-icons/5d5d1fdd5476f3df3749e9fb872e32021ec7a750/variablefont/MaterialSymbolsOutlined%5BFILL%2CGRAD%2Copsz%2Cwght%5D.woff2'",
    "clean-npx": "npm cache npx rm --force",
    "serve": "npm exec -- serve --no-clipboard --no-request-logging --no-etag",
    "watch": "rolldown --config --watch --sourcemap",
    "update-license": "npm exec --package=node-module-license-output@1.0.0 -- third-party-license --license",
    "update-mirakc.d.ts": "npm exec -- openapi-typescript http://mirakc.local:40772/api/docs --output ./src/utils/mirakc.d.ts"
  }
}
