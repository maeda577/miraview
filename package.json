{
  "files": [],
  "type": "module",
  "dependencies": {
    "@siemens/ix": "^2.6.1",
    "@siemens/ix-icons": "^2.2.0",
    "openapi-fetch": "^0.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "license-checker": "^25.0.1",
    "openapi-typescript": "^7.4.4",
    "serve": "^14.2.4",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "postinstall": "npm run cp-modules",
    "clean": "npm run clean-js && npm run clean-modules",
    "clean-js": "node --eval 'fs.globSync(`src/js/*`).forEach(item => fs.rmSync(item, {recursive: true}))'",
    "clean-modules": "node --eval 'fs.globSync(`src/modules/*`).forEach(item => fs.rmSync(item, {recursive: true}))'",
    "precp-modules": "npm run clean-modules",
    "cp-modules": "node --eval '[`@siemens`, `openapi-fetch`].forEach(item => fs.cpSync(`node_modules/` + item, `src/modules/` + item, {recursive: true}))'",
    "start": "npx serve ./src/",
    "watch": "npx tsc --watch",
    "update_license.json": "npx license-checker --production --json --customPath - --relativeLicensePath | grep -v '\"path\":' > src/json/license.json",
    "update_mirakc.d.ts": "npx openapi-typescript http://127.0.0.1:40772/api/docs --output ./src/ts/types/mirakc.d.ts"
  }
}