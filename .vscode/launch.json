{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open miraview (Live Preview)",
      "type": "editor-browser",
      "request": "launch",
      "url": "http://localhost:3000/dist/timetable.html",
      "webRoot": "${workspaceFolder}/",
