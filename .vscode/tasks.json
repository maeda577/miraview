{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "npm",
            "script": "build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "create release archive",
            "type": "process",
            "command": "tar",
            "args": [
                "--create",
                "--gzip",
                "--verbose",
                "--exclude",
                ".DS_Store",
                "--file",
                "build.tar.gz",
                "--directory",
                "${workspaceFolder}/build",
                "."
            ],
            "problemMatcher": [],
            "dependsOrder": "sequence",
            "dependsOn": [ "build for release" ]
        },
        // イメージのビルド コンテナから出て実行する
        {
            "label": "build image",
            "type": "process",
            "command": "docker",
            "args": [
                "build",
                "--pull",
                "--platform",
                "linux/amd64",
                "--tag",
                "ghcr.io/maeda577/miraview:latest",
                "${workspaceFolder}"
            ],
            "problemMatcher": []
        },
        {
            "label": "login to ghcr.io",
            "type": "shell",
            "command": "echo 'https://ghcr.io' | docker-credential-osxkeychain get | docker login ghcr.io",
            "problemMatcher": []
        },
        {
            "label": "push image to ghcr.io",
            "type": "process",
            "command": "docker",
            "args": [
                "push",
                "ghcr.io/maeda577/miraview:latest"
            ],
            "problemMatcher": [],
            "dependsOrder": "sequence",
            "dependsOn": [ "login to ghcr.io", "build image" ]
        }
    ]
}